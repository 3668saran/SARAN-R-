# StudyMate AI - Environment Configuration

# GEMINI_API_KEY: Required for Gemini / Gemma AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Gemma / Gemini model configuration for study assistant
GEMMA_MODEL=gemini-3.5-flash

# Firebase Project Configuration (for backend and web frontend)
FIREBASE_PROJECT_ID=studymate-ai-demo
FIREBASE_STORAGE_BUCKET=studymate-ai-demo.firebasestorage.app
FIREBASE_ADMIN_CREDENTIALS_PATH=serviceAccountKey.json

# Flask Backend Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_SECRET_KEY=studymate_super_secure_secret_key_development_only
FRONTEND_ORIGIN=http://localhost:5000
PORT=5000
