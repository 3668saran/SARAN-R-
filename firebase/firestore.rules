rules_version = '2';

// StudyMate AI — Zero-Trust Backend-Only Firestore Security Rules
// All student profile, marksheet, and skill operations are mediated and authorized
// exclusively by the Node.js / Python backend using the Firebase Admin SDK.
// Direct client SDK access is completely locked down to prevent client-side bypass.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
